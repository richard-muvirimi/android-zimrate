<?xml version="1.0" encoding="utf-8"?>
<!--
    A check-in day already earned. The tile itself carries the state, where before the only
    difference between a claimed day and an unclaimed one was which gift glyph the number
    happened to be drawn beside — a distinction too small to find at a glance.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <padding
        android:bottom="@dimen/padding_4"
        android:left="@dimen/padding_4"
        android:right="@dimen/padding_4"
        android:top="@dimen/padding_4" />
    <corners android:radius="@dimen/padding_8" />
    <solid android:color="?attr/colorPrimaryContainer" />
    <stroke
        android:width="1dp"
        android:color="?attr/colorPrimaryContainer" />

</shape>

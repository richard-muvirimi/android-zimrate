<?xml version="1.0" encoding="utf-8"?><!--
    Compact form of the item_rate row: identity left, name as secondary text beneath it,
    value bold on the right.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/padding_4"
    android:paddingVertical="@dimen/padding_4">

    <ImageView
        android:id="@+id/img_widget_item_flag"
        android:layout_width="28dp"
        android:layout_height="20dp"
        android:contentDescription="@string/content_description_flag"
        android:scaleType="fitCenter"
        tools:src="@mipmap/ic_launcher" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/padding_8"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txt_widget_item_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/widget_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="ZAR" />

        <TextView
            android:id="@+id/txt_widget_item_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/widget_text_secondary"
            android:textSize="10sp"
            tools:text="South African Rand" />

    </LinearLayout>

    <TextView
        android:id="@+id/txt_widget_item_rate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/padding_4"
        android:textColor="@color/widget_text_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="37 000.00" />

</LinearLayout>

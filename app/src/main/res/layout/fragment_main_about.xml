<?xml version="1.0" encoding="utf-8"?>
<!--
    The page scrolls. The fragment is given a fixed height by activity_main (the nav host is
    0dp with a weight inside a viewport sized container), so without a scroll container of its
    own the four cards below are simply cut off at the bottom of the screen — and the last of
    them is the settings list, which is the longest.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Above the balance: who you are, then what you have. -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/paddingWidth"
            android:layout_marginVertical="@dimen/padding_4"
            app:contentPadding="@dimen/padding_8">

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/fragment_account_container"
                android:name="com.tyganeutronics.myratecalculator.fragments.about.FragmentSectionAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/paddingWidth"
                android:layout_marginVertical="@dimen/padding_4"
                android:tag="FragmentAccount" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/paddingWidth"
            android:layout_marginVertical="@dimen/padding_4"
            app:contentPadding="@dimen/padding_8">

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/fragment_balance_container"
                android:name="com.tyganeutronics.myratecalculator.fragments.about.FragmentSectionBalance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/paddingWidth"
                android:layout_marginVertical="@dimen/padding_4"
                android:tag="FragmentBalance" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/paddingWidth"
            android:layout_marginVertical="@dimen/padding_4"
            app:contentPadding="@dimen/padding_8">

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/fragment_rewards_container"
                android:name="com.tyganeutronics.myratecalculator.fragments.about.FragmentSectionRewards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/paddingWidth"
                android:layout_marginVertical="@dimen/padding_4"
                android:tag="FragmentRewards" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/paddingWidth"
            android:layout_marginVertical="@dimen/padding_4"
            app:contentPadding="@dimen/padding_8">

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/nav_host_fragment"
                android:name="com.tyganeutronics.myratecalculator.fragments.about.FragmentSectionSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/paddingWidth"
                android:layout_marginVertical="@dimen/padding_4"
                android:tag="FragmentSettings" />

        </com.google.android.material.card.MaterialCardView>

    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.core.widget.NestedScrollView>

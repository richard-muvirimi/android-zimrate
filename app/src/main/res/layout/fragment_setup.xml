<?xml version="1.0" encoding="utf-8"?><!--
    Rarely seen: the splash holds for the sub-second case, so this only appears on a slow
    connection or none at all. Sized for the message, not for decoration.
-->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/padding_32">

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="@dimen/icon_width_96"
        android:layout_height="@dimen/icon_height_96"
        android:contentDescription="@string/app_name"
        android:src="@mipmap/ic_launcher" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/txt_setup_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_32"
        android:gravity="center_horizontal"
        tools:text="@string/setup_working" />

    <androidx.core.widget.ContentLoadingProgressBar
        android:id="@+id/setup_loading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_16"
        android:indeterminate="true" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_setup_retry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_16"
        android:text="@string/setup_retry"
        android:visibility="gone"
        tools:visibility="visible" />

</androidx.appcompat.widget.LinearLayoutCompat>

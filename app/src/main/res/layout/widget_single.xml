<?xml version="1.0" encoding="utf-8"?><!--
    Mirrors the identity / name / value shape of item_rate: flag on the left, country name and
    sync stamp in the middle, the rate itself bold on the right.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_widget"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/padding_8">

    <ImageView
        android:id="@+id/img_single_flag"
        android:layout_width="44dp"
        android:layout_height="28dp"
        android:contentDescription="@string/content_description_flag"
        android:scaleType="fitCenter"
        tools:src="@mipmap/ic_launcher" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/padding_8"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txt_single_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/widget_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="South Africa" />

        <TextView
            android:id="@+id/txt_single_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/widget_text_secondary"
            android:textSize="10sp"
            android:textStyle="italic"
            android:visibility="gone"
            tools:text="3 hours ago"
            tools:visibility="visible" />

    </LinearLayout>

    <TextView
        android:id="@+id/txt_single_rate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/padding_8"
        android:textColor="@color/widget_text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="37 000.00" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?><!--
    Google first because it is one tap and most people have it; email and password below it as
    the fallback that always works. Both end in the same place — a credential attached to the
    anonymous account the wallet is already under.
-->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/layout_toolbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/paddingWidth"
            android:paddingBottom="@dimen/padding_16">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/txt_account_why"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/padding_16"
                android:text="@string/account_why" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_account_google"
                style="@style/Widget.ZimRate.Button.Google"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/account_google" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/padding_16"
                android:gravity="center_horizontal"
                android:text="@string/account_or" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_account_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/account_email_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_account_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="emailAddress"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress"
                    android:singleLine="true" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_account_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_8"
                android:hint="@string/account_password_hint"
                app:passwordToggleEnabled="true"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_account_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="password"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:singleLine="true" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_account_submit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_16"
                android:text="@string/account_submit" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_account_forgot"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/account_forgot" />

            <androidx.core.widget.ContentLoadingProgressBar
                android:id="@+id/account_loading"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:visibility="gone"
                tools:visibility="visible" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.core.widget.NestedScrollView>

</androidx.appcompat.widget.LinearLayoutCompat>

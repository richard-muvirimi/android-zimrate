<?xml version="1.0" encoding="utf-8"?>
<!-- Mirrors the web calculator's RateRow: a header (flag, name and age, actions) over the two fields. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/padding_8"
    android:layout_marginVertical="@dimen/padding_4"
    app:cardCornerRadius="@dimen/padding_8"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorControlHighlight"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/img_flag"
                android:layout_width="28dp"
                android:layout_height="21dp"
                android:contentDescription="@string/content_description_flag"
                android:scaleType="fitCenter"
                tools:src="@mipmap/ic_launcher" />

            <!-- Name over the sync age; tapping it opens the source. -->
            <LinearLayout
                android:id="@+id/ll_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/padding_8"
                android:layout_marginEnd="@dimen/padding_4"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txt_currency_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    tools:text="ZAR · South Africa" />

                <TextView
                    android:id="@+id/txt_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:singleLine="true"
                    android:visibility="gone"
                    tools:text="3 hours ago"
                    tools:visibility="visible" />

            </LinearLayout>

            <!-- Pin / favourite toggle -->
            <ImageButton
                android:id="@+id/btn_pin"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/content_description_pin"
                android:src="?attr/ic_star_outline"
                tools:src="@drawable/ic_star_outline" />

            <!-- Per-row refresh -->
            <ImageButton
                android:id="@+id/btn_refresh"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/content_description_refresh"
                android:src="?attr/ic_refresh" />

            <!-- Hide; the same as swiping the row away. -->
            <ImageButton
                android:id="@+id/btn_hide"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/content_description_hide"
                android:src="?attr/ic_visibility_off" />

        </LinearLayout>

        <!-- Fields row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_8"
            android:orientation="horizontal">

            <!-- The rate is how many of this currency one dollar buys: "$1 = 31.00". -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_rate"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:layout_marginEnd="@dimen/padding_8"
                android:hint="@string/hint_rate"
                app:prefixText="@string/prefix_one_dollar"
                app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_calculator"
                app:endIconContentDescription="@string/menu_calculator">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_rate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="numberDecimal"
                    android:textSize="14sp"
                    tools:text="37000.00" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Prefixed with the currency code at bind time. -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_amount"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:hint="@string/hint_amount"
                app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_calculator"
                app:endIconContentDescription="@string/menu_calculator"
                tools:prefixText="ZAR">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_amount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="numberDecimal"
                    android:textSize="14sp"
                    tools:text="1.00" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

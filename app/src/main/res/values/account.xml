<resources>

    <!-- Sign in sheet -->
    <string name="account_title">Sign in</string>
    <!--
        Says coins, not "coins you buy". Once signed in there is no difference: every grant lives
        under the account and syncs, however it was earned. Only an account you cannot sign back
        into is stuck on one phone, which is what the anonymous wording below is about.
    -->
    <string name="account_why">Your coins and rates are saved to your account, so they follow you to a new phone. Buying coins needs an account so they can never be lost.</string>
    <string name="account_google">Continue with Google</string>
    <string name="account_or">or</string>
    <string name="account_email_hint">Email address</string>
    <string name="account_password_hint">Password</string>
    <string name="account_submit">Continue</string>
    <string name="account_forgot">Forgot password</string>

    <!-- Outcomes -->
    <string name="account_linked">Signed in as %s. Your coins came with you.</string>
    <string name="account_switched">Signed in as %s. That account already existed, so your coins and rates were moved onto it.</string>
    <string name="account_error_email">Enter a valid email address</string>
    <string name="account_error_password_short">Use at least 6 characters</string>

<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->

    <!--
        Material 3. Every colour role is mapped explicitly from the generated palette in
        values/colors.xml rather than left to the library default, so a widget that reaches for a
        role it was never given before — a tonal button, a filled card, the switch track — lands
        on the brand palette instead of Material's baseline purple.
    -->
    <style name="BaseTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>
        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorOnTertiary">@color/md_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_on_tertiary_container</item>
        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container</item>
        <item name="android:colorBackground">@color/md_background</item>
        <item name="colorOnBackground">@color/md_on_background</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>
        <item name="colorSurfaceInverse">@color/md_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/md_inverse_on_surface</item>
        <item name="colorPrimaryInverse">@color/md_inverse_primary</item>
        <item name="colorSurfaceContainerLowest">@color/md_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/md_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/md_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/md_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/md_surface_container_highest</item>

        <!-- Brand blue, kept for the pre-API-21 status bar slot the platform still reads. -->
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <!-- The AppCompat widgets and the preference screen read colorAccent, not colorPrimary. -->
        <item name="colorAccent">@color/md_primary</item>
        <!--
            An accent that stays legible in both themes. Now just the primary role, which already
            flips tone between day and night; see the note in values/colors.xml.
        -->
        <item name="colorPrimaryLight">@color/colorPrimaryLight</item>

        <item name="calcDialogStyle">@style/AppTheme.CalcDialog</item>
        <!--
            Material 3 does not set preferenceTheme, so without this the preference library falls
            back to its own default overlay and the settings rows lose the category styling below.
        -->
        <item name="preferenceTheme">@style/ThemeOverlay.Zimrate.Preference</item>
    </style>

    <style name="Theme.App.Starting" parent="AppTheme" />

    <style name="AppTheme.Base" parent="BaseTheme">
        <!--
            Matches the system navigation bar to the BottomAppBar sitting in front of it, which
            draws on colorSurface and so follows day/night on its own. Ignored from API 35, where
            enforced edge to edge makes the system bar transparent and the app bar shows through
            anyway; below that it replaces the platform default black.
        -->
        <item name="android:navigationBarColor">?attr/colorSurface</item>
    </style>

    <!--
        Settings. The category headings take the primary colour, which is the Material 3 settings
        idiom and the thing that makes a long preference list scannable.
    -->
    <style name="ThemeOverlay.Zimrate.Preference" parent="PreferenceThemeOverlay">
        <item name="preferenceCategoryTitleTextAppearance">@style/TextAppearance.Zimrate.PreferenceCategory</item>
        <item name="preferenceCategoryTitleTextColor">?attr/colorPrimary</item>
    </style>

    <style name="TextAppearance.Zimrate.PreferenceCategory" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textStyle">bold</item>
    </style>

    <!--
        A percentage corner size stays a circle at any diameter, which the glance bubbles need
        because each one is sized at bind time.
    -->
    <style name="ShapeAppearance.Zimrate.Bubble" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!--
        An option on the rates screen's aggregate switch: no stroke or tick, muted until chosen,
        then a tinted pill inside bg_aggregate_track — the same look as the website's switch.
    -->
    <style name="AppTheme.AggregateChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/aggregate_chip_background</item>
        <item name="android:textColor">@color/aggregate_chip_text</item>
        <item name="android:textAppearance">@style/AppTheme.AggregateChip.Text</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <style name="AppTheme.AggregateChip.Text" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textStyle">bold</item>
    </style>

    <!--layout_toolbar-->

    <style name="AppTheme.Toolbar.Expanded" parent="TextAppearance.Material3.HeadlineMedium">

    </style>

    <style name="AppTheme.Toolbar.Collapsed" parent="TextAppearance.Material3.TitleLarge">

    </style>

    <!--calculator-->

    <!--
        The calculator dialog comes from a library that styles its own widgets off AppCompat, so
        these parents stay as they are; they pick the new palette up through colorPrimaryLight.
    -->
    <style name="AppTheme.CalcDialog" parent="CalcDialogStyle">
        <item name="calcOperationBtnStyle">@style/AppTheme.CalcDialog.Button</item>
        <item name="calcEraseBtnStyle">@style/AppTheme.CalcDialog.CalcEraseBtnStyle</item>
        <item name="calcExpressionStyle">@style/AppTheme.CalcDialog.CalcExpressionStyle</item>
        <item name="calcDialogButtonStyle">@style/AppTheme.CalcDialog.CalcDialogButtonStyle</item>
        <item name="calcAnswerBtnStyle">@style/AppTheme.CalcDialog.CalcAnswerBtnStyle</item>
        <item name="calcOperationBtnColor">@color/colorPrimaryLight</item>
        <item name="calcDividerColor">@color/colorPrimaryLight</item>

        <item name="calcButtonTextClear">@string/calculator_dialog_clear</item>
        <item name="calcButtonTextCancel">@string/calculator_dialog_cancel</item>
        <item name="calcButtonTextOk">@string/calculator_dialog_ok</item>

        <item name="calcErrors">@array/calculator_dialog_errors</item>
    </style>

    <style name="AppTheme.CalcDialog.Button" parent="CalcOperationBtnStyle">
        <item name="android:textColor">@android:color/white</item>
        <item name="selectableItemBackground">@color/colorPrimary</item>
    </style>

    <style name="AppTheme.CalcDialog.CalcEraseBtnStyle" parent="CalcEraseBtnStyle">
        <item name="android:contentDescription">@string/calculator_dialog_erase</item>
        <item name="tint">@color/colorPrimaryLight</item>
    </style>

    <style name="AppTheme.CalcDialog.CalcExpressionStyle" parent="CalcExpressionStyle">
        <item name="android:textColor">?attr/colorPrimaryLight</item>
    </style>

    <style name="AppTheme.CalcDialog.CalcAnswerBtnStyle" parent="CalcAnswerBtnStyle">
        <item name="android:text">@string/calculator_answer</item>
    </style>

    <style name="AppTheme.CalcDialog.CalcDialogButtonStyle" parent="Widget.AppCompat.Button.Borderless.Colored">
        <item name="android:textColor">?attr/colorPrimaryLight</item>
    </style>

    <!--
        Google sign-in button. Shape, colours and the logo are Google's to specify, not ours.
        iconTint is explicitly cleared: Material tints an icon to the text colour by default,
        which would flatten the four-colour G to a single shade and breach the guidelines.
    -->
    <style name="Widget.ZimRate.Button.Google" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/google_btn_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="backgroundTint">@color/google_btn_background</item>
        <item name="strokeColor">@color/google_btn_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">20dp</item>
        <item name="icon">@drawable/ic_google</item>
        <item name="iconTint">@null</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">12dp</item>
        <!--
            48dp rather than the 40dp minimum Google specifies, so it matches the filled button
            below it — at 40dp against a 48dp neighbour it reads as a thinner, lesser control,
            which is the opposite of the intent. Insets cleared because Material's default 6dp
            top and bottom eat into the height that was just asked for.
        -->
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconSize">20dp</item>
    </style>
</resources>

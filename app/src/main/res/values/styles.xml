<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->

    <style name="BaseTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorPrimaryLight</item>
        <!--
            Material components read colorSecondary rather than the AppCompat colorAccent above.
            Left unset it resolves to the Material default teal, which is not in this palette —
            the FAB was the first component to show it up.
        -->
        <item name="colorSecondary">@color/colorPrimaryLight</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="calcDialogStyle">@style/AppTheme.CalcDialog</item>
    </style>

    <style name="Theme.App.Starting" parent="AppTheme" />

    <style name="AppTheme.Base" parent="BaseTheme">
        <!--
            Matches the system navigation bar to the BottomAppBar sitting in front of it, which
            draws on colorSurface and so follows day/night on its own. Ignored from API 35, where
            enforced edge to edge makes the system bar transparent and the app bar shows through
            anyway; below that it replaces the platform default black.
        -->
        <item name="android:navigationBarColor">?attr/colorSurface</item>
    </style>

    <!--
        A percentage corner size stays a circle at any diameter, which the glance bubbles need
        because each one is sized at bind time.
    -->
    <style name="ShapeAppearance.Zimrate.Bubble" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!--layout_toolbar-->

    <style name="AppTheme.Toolbar.Expanded" parent="TextAppearance.MaterialComponents.Headline4">

    </style>

    <style name="AppTheme.Toolbar.Collapsed" parent="TextAppearance.MaterialComponents.Headline6">

    </style>

    <!--calculator-->

    <style name="AppTheme.CalcDialog" parent="CalcDialogStyle">
        <item name="calcOperationBtnStyle">@style/AppTheme.CalcDialog.Button</item>
        <item name="calcEraseBtnStyle">@style/AppTheme.CalcDialog.CalcEraseBtnStyle</item>
        <item name="calcExpressionStyle">@style/AppTheme.CalcDialog.CalcExpressionStyle</item>
        <item name="calcDialogButtonStyle">@style/AppTheme.CalcDialog.CalcDialogButtonStyle</item>
        <item name="calcAnswerBtnStyle">@style/AppTheme.CalcDialog.CalcAnswerBtnStyle</item>
        <item name="calcOperationBtnColor">@color/colorPrimaryLight</item>
        <item name="calcDividerColor">@color/colorPrimaryLight</item>

        <item name="calcButtonTextClear">@string/calculator_dialog_clear</item>
        <item name="calcButtonTextCancel">@string/calculator_dialog_cancel</item>
        <item name="calcButtonTextOk">@string/calculator_dialog_ok</item>

        <item name="calcErrors">@array/calculator_dialog_errors</item>
    </style>

    <style name="AppTheme.CalcDialog.Button" parent="CalcOperationBtnStyle">
        <item name="android:textColor">@android:color/white</item>
        <item name="selectableItemBackground">@color/colorPrimary</item>
    </style>

    <style name="AppTheme.CalcDialog.CalcEraseBtnStyle" parent="CalcEraseBtnStyle">
        <item name="android:contentDescription">@string/calculator_dialog_erase</item>
        <item name="tint">@color/colorPrimaryLight</item>
    </style>

    <style name="AppTheme.CalcDialog.CalcExpressionStyle" parent="CalcExpressionStyle">
        <item name="android:textColor">?attr/colorPrimaryLight</item>
    </style>

    <style name="AppTheme.CalcDialog.CalcAnswerBtnStyle" parent="CalcAnswerBtnStyle">
        <item name="android:text">@string/calculator_answer</item>
    </style>

    <style name="AppTheme.CalcDialog.CalcDialogButtonStyle" parent="Widget.AppCompat.Button.Borderless.Colored">
        <item name="android:textColor">?attr/colorPrimaryLight</item>
    </style>

    <!--Widgets-->
    <style name="AppTheme.TextInputLayout" parent="@style/Widget.Design.TextInputLayout">
        <item name="startIconTint">?attr/colorPrimaryLight</item>
        <item name="counterMaxLength">@integer/maxvalue</item>
        <item name="android:paddingBottom">@dimen/padding_8</item>
        <item name="startIconDrawable">@drawable/ic_calculator</item>
        <item name="helperTextTextColor">?attr/colorPrimaryLight</item>
    </style>

    <!--Edit text app style-->
    <style name="AppTheme.EditText" parent="@style/Widget.AppCompat.EditText">
        <!--<item name="android:background">@android:color/transparent</item>-->
    </style>

    <style name="AppTheme.Button" parent="Widget.AppCompat.Button.Borderless">
        <item name="drawableTint">?attr/colorPrimaryLight</item>
    </style>


    <!--
        Google sign-in button. Shape, colours and the logo are Google's to specify, not ours.
        iconTint is explicitly cleared: Material tints an icon to the text colour by default,
        which would flatten the four-colour G to a single shade and breach the guidelines.
    -->
    <style name="Widget.ZimRate.Button.Google" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/google_btn_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="backgroundTint">@color/google_btn_background</item>
        <item name="strokeColor">@color/google_btn_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">20dp</item>
        <item name="icon">@drawable/ic_google</item>
        <item name="iconTint">@null</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">12dp</item>
        <!--
            48dp rather than the 40dp minimum Google specifies, so it matches the filled button
            below it — at 40dp against a 48dp neighbour it reads as a thinner, lesser control,
            which is the opposite of the intent. Insets cleared because Material's default 6dp
            top and bottom eat into the height that was just asked for.
        -->
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconSize">20dp</item>
    </style>
</resources>
